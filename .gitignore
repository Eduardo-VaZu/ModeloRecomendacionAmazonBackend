/.claude

# Entorno
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Datos y artefactos generados (se reproducen con scripts/)
data/**
!data/**/
!data/**/.gitkeep
artifacts/*
!artifacts/.gitkeep
reports/tables/*
!reports/tables/.gitkeep
# Evidencia para la tesis: resultados en test y ajuste en validación
!reports/tables/results.csv
!reports/tables/tuning_*.csv
!reports/tables/best_params.json
reports/figures/*
!reports/figures/.gitkeep

# Backend del prototipo
.env
backend/.venv/
